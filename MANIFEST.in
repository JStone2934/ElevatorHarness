include LICENSE README.md README.zh-CN.md
recursive-include docs *.md
recursive-include examples *.py *.json *.md *.sh *.cpp
recursive-include tests *.py
prune outputs
prune .venv
prune .conda
prune .deps
prune .cache
prune .git
prune scripts
prune configs
prune src/pressb
global-exclude __pycache__ *.py[cod] *.bin .env .env.* *.jpg *.png *.npy *.key *.pem
